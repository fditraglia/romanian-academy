{"category": "connectives", "label": "Connectives", "items": [{"key": "așa-că", "prompt": "so, therefore (result)", "ro": "așa că", "note": "introduces a consequence", "examples": [{"ro": "Plouă, așa că rămân.", "en": "It's raining, so I'm staying.", "audio": "9277f926f4f3c2d1"}], "audio": "91a1dfce6f210435"}, {"key": "ca-sa", "prompt": "in order to, so that", "ro": "ca să", "note": "purpose; takes the subjunctive", "ety": "ca + să", "examples": [{"ro": "Învăț ca să reușesc.", "en": "I study in order to succeed.", "audio": "18d982a16535f11a"}], "audio": "0663ac19221727a0"}, {"key": "căci", "prompt": "because, for", "ro": "căci", "note": "literary 'for / because'", "ety": "că + ci", "examples": [{"ro": "Mă grăbesc, căci e târziu.", "en": "I'm hurrying, for it's late.", "audio": "3e86d6c8f14ae44d"}], "audio": "147d042e45e1a964"}, {"key": "când", "prompt": "when", "ro": "când", "ety": "Lat. quando", "examples": [{"ro": "Când vii?", "en": "When are you coming?", "sense": "question", "audio": "895b621480d0e8fe"}, {"ro": "când eram mic", "en": "when I was little", "sense": "relative", "audio": "63c0e336459b2984"}], "audio": "a321a6faacafed04"}, {"key": "chiar-dacă", "prompt": "even if, even though", "ro": "chiar dacă", "note": "concessive", "examples": [{"ro": "chiar dacă plouă", "en": "even if it rains", "audio": "725c9c3be20440ae"}], "audio": "70710b39ccad2da6"}, {"key": "ci", "prompt": "but rather", "ro": "ci", "note": "corrective after a negative: nu X, ci Y", "ety": "from ce (< Lat. quid)", "examples": [{"ro": "Nu azi, ci mâine.", "en": "Not today, but rather tomorrow.", "audio": "171d14a4a45ebef8"}], "audio": "09f9dc7af8032117"}, {"key": "dacă", "prompt": "if; whether", "ro": "dacă", "note": "conditional 'if'; also 'whether'", "ety": "de + că (the conjunction; NOT lat. Dacus — that's the adjective dac 'Dacian')", "examples": [{"ro": "Dacă vrei, mergem.", "en": "If you want, we'll go.", "sense": "if", "audio": "e1688f0464fbb496"}, {"ro": "Nu știu dacă vine.", "en": "I don't know whether he's coming.", "sense": "whether", "audio": "2a9e731bf2d23974"}], "audio": "18bf43b29d547851"}, {"key": "dar", "prompt": "but", "ro": "dar", "note": "the everyday 'but'", "ety": "uncertain (cf. the noun dar 'gift' < Slavic darŭ)", "examples": [{"ro": "Vreau, dar nu pot.", "en": "I want to, but I can't.", "audio": "b72129914f5e1e56"}], "audio": "b7a74649750787cd"}, {"key": "de-aceea", "prompt": "that's why, therefore", "ro": "de aceea", "note": "literally 'of that'", "examples": [{"ro": "De aceea am venit.", "en": "That's why I came.", "audio": "48426746cc757068"}], "audio": "bf0905de162c6e45"}, {"key": "de-altfel", "prompt": "besides, incidentally", "ro": "de altfel", "note": "adds a confirming aside", "examples": [{"ro": "De altfel, e târziu.", "en": "Besides, it's late.", "audio": "ab1039d69f58f57d"}], "audio": "a68400ac1a582436"}, {"key": "de-asemenea", "prompt": "also, likewise, as well", "ro": "de asemenea", "note": "adds a further point", "ety": "de + asemenea (< Lat. assimile, ad + similis 'similar')", "examples": [{"ro": "De asemenea, mulțumesc.", "en": "Likewise, thank you.", "audio": "56e11fa2ac4c7bbd"}], "audio": "cb5c85eb994ef634"}, {"key": "de-fapt", "prompt": "actually, in fact", "ro": "de fapt", "note": "literally 'of fact'", "examples": [{"ro": "De fapt, n-am știut.", "en": "Actually, I didn't know.", "audio": "7182550e5d0afd4d"}], "audio": "7d029f47443675c4"}, {"key": "de-parcă", "prompt": "as if, as though", "ro": "de parcă", "note": "unreal comparison", "examples": [{"ro": "de parcă nu știa", "en": "as if he didn't know", "audio": "04176441cd058445"}], "audio": "a958ccafc42c4e44"}, {"key": "deci", "prompt": "so, therefore", "ro": "deci", "note": "sums up / draws a conclusion in speech", "ety": "Romanian coinage, not Latin (Sala)", "examples": [{"ro": "Deci, ce facem?", "en": "So, what do we do?", "audio": "035bd3fa4f462280"}], "audio": "015e434c7439d06e"}, {"key": "deși", "prompt": "although, even though", "ro": "deși", "ety": "de + și", "examples": [{"ro": "Deși plouă, ies.", "en": "Although it's raining, I'm going out.", "audio": "946279bc8d9438e2"}], "audio": "e143ca7f18d336b1"}, {"key": "fiindcă", "prompt": "because, since", "ro": "fiindcă", "note": "a touch more written/causal than pentru că", "ety": "fiind ('being') + că", "examples": [{"ro": "Stau acasă fiindcă sunt obosit.", "en": "I'm staying home because I'm tired.", "audio": "bc837a3cac9dafcf"}], "audio": "a9209ee00e758b0a"}, {"key": "iar", "prompt": "and; whereas; again", "ro": "iar", "note": "links or contrasts clauses; with a verb = 'again'", "ety": "uncertain", "examples": [{"ro": "Eu citesc, iar el doarme.", "en": "I read, while he sleeps.", "sense": "whereas", "audio": "4960eede2dc88989"}, {"ro": "Iar plouă.", "en": "It's raining again.", "sense": "again", "audio": "0d2a45fb4dd86345"}], "audio": "46faacfb33e892c5"}, {"key": "însă", "prompt": "but, however", "ro": "însă", "note": "more formal; usually follows the first word/clause", "ety": "Lat. ipsa", "examples": [{"ro": "E greu, însă merită.", "en": "It's hard, but it's worth it.", "audio": "7912199f1fa57743"}], "audio": "800d76b7f5ae8c17"}, {"key": "nici", "prompt": "nor, not even", "ro": "nici", "note": "nici… nici = neither… nor", "ety": "Lat. nec", "examples": [{"ro": "Nici eu nu știu.", "en": "I don't know either.", "sense": "not even / either", "audio": "b8cf6c93e7aa7b17"}, {"ro": "nici cald, nici rece", "en": "neither hot nor cold", "sense": "neither… nor", "audio": "db8bb7478934f076"}], "audio": "0c5ea703483e6412"}, {"key": "pe-de-altă-parte", "prompt": "on the other hand", "ro": "pe de altă parte", "note": "pairs with 'pe de o parte' (on one hand)", "examples": [{"ro": "Pe de altă parte, e scump.", "en": "On the other hand, it's expensive.", "audio": "4cee134e6906df15"}], "audio": "4a8a5a28d02d71ec"}, {"key": "pentru-ca", "prompt": "because", "ro": "pentru că", "note": "the spoken, everyday 'because'", "ety": "pentru + că", "examples": [{"ro": "Nu vin, pentru că plouă.", "en": "I'm not coming because it's raining.", "audio": "726f8406201ce98f"}], "audio": "c0d24d6e0ea06224"}, {"key": "precum", "prompt": "as, just as, like", "ro": "precum", "note": "comparison / manner (more formal)", "ety": "pre + cum", "examples": [{"ro": "precum știi", "en": "as you know", "audio": "49557e12b9d1b84a"}], "audio": "2143764491500e8d"}, {"key": "sau", "prompt": "or", "ro": "sau", "note": "inclusive 'or'; cf. ori", "ety": "uncertain", "examples": [{"ro": "Ceai sau cafea?", "en": "Tea or coffee?", "audio": "c12d5306a75c53ea"}], "audio": "e32d08ff521ee0b6"}, {"key": "totuși", "prompt": "still, nevertheless", "ro": "totuși", "ety": "tot + și", "examples": [{"ro": "E scump, totuși îl iau.", "en": "It's expensive; still, I'll take it.", "audio": "ed27c24cc9bf6e91"}], "audio": "cbdcc5004eff346c"}]}
{"category": "time-sequence", "label": "Time & sequence", "items": [{"key": "acum", "prompt": "now", "ro": "acum", "note": "acum + time span = 'X ago'", "ety": "Lat. eccum modo", "examples": [{"ro": "Vino acum!", "en": "Come now!", "sense": "now", "audio": "0473d9c66936d76c"}, {"ro": "acum doi ani", "en": "two years ago", "sense": "+ span = ago", "audio": "bde64cdf7be54e60"}], "audio": "fa421da091386f20"}, {"key": "apoi", "prompt": "then, next, afterwards", "ro": "apoi", "ety": "Lat. ad-post", "examples": [{"ro": "Mănânc, apoi plec.", "en": "I eat, then I leave.", "audio": "e1f0e66ae9cba82f"}], "audio": "b23f3dcbc143b421"}, {"key": "atunci", "prompt": "then (at that time)", "ro": "atunci", "note": "also 'in that case'", "ety": "Lat. *ad-tuncce", "examples": [{"ro": "Atunci am plecat.", "en": "Then I left.", "sense": "at that time", "audio": "99ac6ac6a5c65467"}, {"ro": "Atunci hai!", "en": "In that case, let's go!", "sense": "in that case", "audio": "d64353b85687a8c0"}], "audio": "dd77dedb7f276373"}, {"key": "azi", "prompt": "today", "ro": "azi", "ro_alt": ["astăzi"], "note": "azi (colloquial) = astăzi", "ety": "Lat. hac die", "examples": [{"ro": "Azi e luni.", "en": "Today is Monday.", "audio": "9be3fbadae43854d"}], "audio": "f94d63473a4385fd"}, {"key": "de-obicei", "prompt": "usually", "ro": "de obicei", "note": "literally 'of habit'", "examples": [{"ro": "De obicei merg pe jos.", "en": "I usually walk.", "audio": "41ffa2a35fe0a3e6"}], "audio": "261d62bb89945ea8"}, {"key": "deja", "prompt": "already", "ro": "deja", "ety": "from French déjà", "examples": [{"ro": "E deja gata.", "en": "It's already done.", "audio": "8c75ac8401ab284a"}], "audio": "bc151973e61fdf44"}, {"key": "ieri", "prompt": "yesterday", "ro": "ieri", "ety": "Lat. heri", "examples": [{"ro": "Ieri am lucrat.", "en": "Yesterday I worked.", "audio": "a4b0822f1995c343"}], "audio": "41890281b2e7828d"}, {"key": "imediat", "prompt": "immediately, right away", "ro": "imediat", "ety": "Fr. immédiat / Lat. immediatus", "examples": [{"ro": "Vin imediat.", "en": "I'm coming right away.", "audio": "a487734f44ffbde9"}], "audio": "303e97c6686a5030"}, {"key": "încă", "prompt": "still, yet", "ro": "încă", "note": "with a negative = 'not yet'; also 'încă un' = one more", "ety": "Lat. unquam", "examples": [{"ro": "Încă nu.", "en": "Not yet.", "sense": "yet (neg.)", "audio": "e37925a1372ff3e9"}, {"ro": "încă o cafea", "en": "one more coffee", "sense": "one more", "audio": "1c848e896ea22b5f"}], "audio": "56698ac402ee2d77"}, {"key": "mâine", "prompt": "tomorrow", "ro": "mâine", "ety": "Lat. mane ('morning')", "examples": [{"ro": "Pe mâine!", "en": "See you tomorrow!", "audio": "a4ed4f517bf19682"}], "audio": "e93b35697dadc4bd"}, {"key": "mereu", "prompt": "always, constantly", "ro": "mereu", "note": "habitual 'always'; cf. întotdeauna", "ety": "cf. Hungarian merő", "examples": [{"ro": "Mereu întârzie.", "en": "He's always late.", "audio": "e6deb5d742353112"}], "audio": "1182d629944e5745"}, {"key": "niciodată", "prompt": "never", "ro": "niciodată", "note": "with nu: nu… niciodată", "ety": "nici + o + dată ('not one time')", "examples": [{"ro": "Nu vin niciodată.", "en": "I never come.", "audio": "ecbbe316905fb760"}], "audio": "648c675b27824df8"}, {"key": "tot", "prompt": "still / keep -ing / all", "ro": "tot", "note": "continuation, totality; 'tot mai' = more and more", "ety": "Lat. totus", "examples": [{"ro": "Tot plouă.", "en": "It keeps raining.", "sense": "keep -ing", "audio": "d1f6a518324f1afb"}, {"ro": "tot orașul", "en": "the whole city", "sense": "all / whole", "audio": "4d7953d4ee78bf62"}], "audio": "477af9d9c1d437dd"}]}
{"category": "prepositions", "label": "Prepositions", "items": [{"key": "către", "prompt": "toward; to (a person)", "ro": "către", "note": "more formal than spre", "ety": "Lat. contra", "examples": [{"ro": "către tine", "en": "toward you", "audio": "55d937534105af0b"}], "audio": "61804dbb31e9349c"}, {"key": "cu", "prompt": "with", "ro": "cu", "ety": "Lat. cum", "examples": [{"ro": "cu tine", "en": "with you", "audio": "448c0b12e9c49b52"}], "audio": "7291f9316df9a5e7"}, {"key": "de", "prompt": "of, from", "ro": "de", "note": "very polysemous: possession, material, 'de + infinitive'", "ety": "Lat. de", "examples": [{"ro": "o ceașcă de cafea", "en": "a cup of coffee", "sense": "of", "audio": "404f9206c58ab075"}, {"ro": "sunt de aici", "en": "I'm from here", "sense": "from", "audio": "6092183dd8e3cecc"}], "audio": "38939803cdf2ba0b"}, {"key": "despre", "prompt": "about", "ro": "despre", "ety": "de + spre", "examples": [{"ro": "Despre ce?", "en": "About what?", "audio": "4a833bf3c598ae72"}, {"ro": "o carte despre război", "en": "a book about war", "audio": "f20808d43ac4e5bf"}], "audio": "cf7af25f8eac7603"}, {"key": "din", "prompt": "from (out of)", "ro": "din", "note": "origin / material", "ety": "de + în (contracted)", "examples": [{"ro": "Sunt din România.", "en": "I'm from Romania.", "sense": "origin", "audio": "7c2962560cc0e4f9"}, {"ro": "din lemn", "en": "(made) of wood", "sense": "out of", "audio": "5478433821ffa8fb"}], "audio": "371d962ebdc71405"}, {"key": "după", "prompt": "after; behind", "ro": "după", "note": "both time and place", "ety": "Lat. de post", "examples": [{"ro": "după aceea", "en": "after that", "sense": "time", "audio": "3361430574eb7730"}, {"ro": "după ușă", "en": "behind the door", "sense": "place", "audio": "344ad147cfeae39a"}], "audio": "a95a404133f1fe21"}, {"key": "fără", "prompt": "without", "ro": "fără", "ety": "Lat. foras ('outside')", "examples": [{"ro": "fără zahăr", "en": "without sugar", "audio": "d1cd30717298bdff"}], "audio": "7ef08c28ffc32c23"}, {"key": "în", "prompt": "in, into", "ro": "în", "ety": "Lat. in", "examples": [{"ro": "în casă", "en": "in the house", "audio": "f36164ce7e251a60"}], "audio": "4c9594600ab2df2e"}, {"key": "la", "prompt": "at, to", "ro": "la", "note": "place; also clock time", "ety": "Lat. illac", "examples": [{"ro": "la școală", "en": "at / to school", "sense": "place", "audio": "19017bf42ba58f64"}, {"ro": "la ora cinci", "en": "at five o'clock", "sense": "time", "audio": "6998a18c6c17fa90"}], "audio": "d11a07162c81cf7d"}, {"key": "lângă", "prompt": "next to, beside", "ro": "lângă", "ety": "Lat. longum ad", "examples": [{"ro": "lângă mine", "en": "next to me", "audio": "eebec82729a4acf8"}], "audio": "81835942746cb469"}, {"key": "până", "prompt": "until, up to, as far as", "ro": "până", "note": "până la / până când", "ety": "Lat. paene-ad", "examples": [{"ro": "până mâine", "en": "until tomorrow", "sense": "time", "audio": "3a01bb345d7aa974"}, {"ro": "până la gară", "en": "as far as the station", "sense": "place", "audio": "e092b1052128dfea"}], "audio": "462d36d2aeb9b729"}, {"key": "pe", "prompt": "on; (object marker)", "ro": "pe", "note": "also marks a definite/personal direct object", "ety": "Lat. per", "examples": [{"ro": "pe masă", "en": "on the table", "sense": "on", "audio": "957a21e7dcdad89a"}, {"ro": "îl văd pe Ion", "en": "I see Ion", "sense": "object marker", "audio": "bc1fe6473b08fe18"}], "audio": "7b342ac769901716"}, {"key": "pentru", "prompt": "for", "ro": "pentru", "ety": "from printru (< pre + intru)", "examples": [{"ro": "pentru tine", "en": "for you", "audio": "45bb0f7f4f2ca452"}], "audio": "f595a90961ee21cb"}, {"key": "peste", "prompt": "over, across; in (time)", "ro": "peste", "note": "peste + time = 'in X'", "ety": "Lat. per + iste", "examples": [{"ro": "peste pod", "en": "over the bridge", "sense": "over", "audio": "5f119019ccf22e01"}, {"ro": "peste o oră", "en": "in an hour", "sense": "in (time)", "audio": "ecce482082a8d40c"}], "audio": "100349c0c3779931"}, {"key": "prin", "prompt": "through; by means of", "ro": "prin", "ety": "Lat. per + in", "examples": [{"ro": "prin oraș", "en": "through the city", "sense": "through", "audio": "1dfb1740f3584663"}, {"ro": "prin telefon", "en": "by phone", "sense": "by means of", "audio": "aa5575d5d9e5585d"}], "audio": "86bbbf6979399589"}, {"key": "spre", "prompt": "toward; around (time)", "ro": "spre", "ety": "Lat. super", "examples": [{"ro": "spre casă", "en": "toward home", "sense": "direction", "audio": "440acbbda22dcb32"}, {"ro": "spre seară", "en": "toward evening", "sense": "time", "audio": "23f2ab290906e27e"}], "audio": "aaf8d5ebbe70b2e1"}]}
{"category": "demonstratives-degree", "label": "Demonstratives & degree", "items": [{"key": "abia", "prompt": "barely, hardly; only just", "ro": "abia", "note": "'abia aștept' = I can't wait", "ety": "Lat. ad vix", "examples": [{"ro": "abia aștept", "en": "I can't wait", "sense": "barely (idiom)", "audio": "421f4e1a615dbf68"}, {"ro": "abia acum", "en": "only just now", "sense": "only just", "audio": "99f2ea3bd0b436df"}], "audio": "0f66ffce9c027122"}, {"key": "acolo", "prompt": "there", "ro": "acolo", "ety": "Lat. eccum illoc", "examples": [{"ro": "E acolo.", "en": "It's there.", "audio": "2fa5ea203cff9139"}], "audio": "e7154a8587161437"}, {"key": "aici", "prompt": "here", "ro": "aici", "ety": "Lat. ad-hicca", "examples": [{"ro": "Vino aici.", "en": "Come here.", "audio": "1543def01f2fe6a0"}], "audio": "cf1c6eab32413429"}, {"key": "astfel", "prompt": "thus, in this way", "ro": "astfel", "note": "astfel încât = so that", "ety": "ast + fel ('this manner')", "examples": [{"ro": "astfel încât", "en": "so that / such that", "audio": "e741aa598dc480be"}], "audio": "146556e2ce8c5858"}, {"key": "așa", "prompt": "like that, so, thus", "ro": "așa", "note": "manner; 'așa și așa' = so-so", "ety": "Lat. eccum-sic", "examples": [{"ro": "Așa e.", "en": "That's how it is.", "sense": "like that", "audio": "3c2a2597086751e6"}, {"ro": "așa de frumos", "en": "so beautiful", "sense": "so + adj", "audio": "544db45c6991f4da"}], "audio": "363fa2cef201fbb3"}, {"key": "atât", "prompt": "so much; that's all", "ro": "atât", "note": "atât de + adj = 'so…'", "ety": "Lat. eccum-tantum", "examples": [{"ro": "atât de frumos", "en": "so beautiful", "sense": "so much", "audio": "1db58751024e6337"}, {"ro": "Atât!", "en": "That's all!", "sense": "that's all", "audio": "0a340bd926d54311"}], "audio": "8ae1cb0e7faaa4c4"}, {"key": "cam", "prompt": "roughly, rather, kind of", "ro": "cam", "note": "approximation / hedge", "ety": "from camai ('and more')", "examples": [{"ro": "cam târziu", "en": "rather late", "sense": "rather", "audio": "c93edcfc803af4ae"}, {"ro": "cam zece", "en": "about ten", "sense": "roughly", "audio": "6ec0a38783d39aac"}], "audio": "d9c113bfb8ed7708"}, {"key": "chiar", "prompt": "even; really; right", "ro": "chiar", "note": "emphasis: 'chiar așa?' = really?", "ety": "Lat. clarus ('clearly')", "examples": [{"ro": "chiar așa?", "en": "really? / exactly so?", "sense": "really", "audio": "b8790b7d0484de90"}, {"ro": "chiar acum", "en": "right now", "sense": "right / exactly", "audio": "a9d781a76e2641b8"}], "audio": "6d1cd031993e53d8"}, {"key": "decât", "prompt": "than; only (with a negative)", "ro": "decât", "note": "comparative 'than' with mai; restrictive 'only' after a negative", "ety": "de + cât (cât < Lat. quantum)", "examples": [{"ro": "mai mare decât tine", "en": "bigger than you", "sense": "than", "audio": "0747dc66ef4a2edc"}, {"ro": "N-am decât doi lei.", "en": "I only have two lei.", "sense": "only (neg.)", "audio": "a6378c7e7a1b376f"}], "audio": "4975ab716311437b"}, {"key": "deloc", "prompt": "(not) at all, in the least", "ro": "deloc", "note": "negative-polarity: pairs with nu to intensify the negation", "ety": "de + loc (lit. 'of place')", "examples": [{"ro": "Nu-mi place deloc.", "en": "I don't like it at all.", "sense": "with a negative", "audio": "90be743e515235f3"}, {"ro": "Deloc!", "en": "Not at all! / No way!", "sense": "standalone reply", "audio": "07aae2f669208624"}], "audio": "a38795c9b9855b1f"}, {"key": "destul", "prompt": "enough; quite", "ro": "destul", "note": "destul de + adj = 'fairly / quite'", "ety": "uncertain", "examples": [{"ro": "destul de bine", "en": "quite well / well enough", "sense": "+ adj", "audio": "711774075a86f915"}, {"ro": "Destul!", "en": "Enough!", "sense": "standalone", "audio": "917c12aeab5ca2d7"}], "audio": "f757c7cade04442f"}, {"key": "doar", "prompt": "only, just", "ro": "doar", "note": "restrictive 'only'; also a softener", "ety": "Lat. de hora", "examples": [{"ro": "doar puțin", "en": "just a little", "sense": "only", "audio": "382b64461e7ea4f9"}, {"ro": "Doar glumesc.", "en": "I'm only joking.", "sense": "softener", "audio": "5e735501eec0b26e"}], "audio": "c2831ae2ca7bda6a"}, {"key": "foarte", "prompt": "very", "ro": "foarte", "note": "intensifies adj/adv", "ety": "Lat. forte ('strongly')", "examples": [{"ro": "foarte bine", "en": "very well", "audio": "b9f6de428f7b6cf1"}], "audio": "30303c42964ab704"}, {"key": "mai", "prompt": "more; -er (comparative)", "ro": "mai", "note": "comparative marker; 'nu mai' = no longer", "ety": "Lat. magis", "examples": [{"ro": "mai mare", "en": "bigger", "sense": "comparative", "audio": "aa76c77e68c1990e"}, {"ro": "mai vrei?", "en": "do you want more?", "sense": "more", "audio": "cc53de6cb7e0f4cd"}], "audio": "e038c6455d36019c"}, {"key": "numai", "prompt": "only", "ro": "numai", "note": "≈ doar; 'numai că' = except that", "ety": "nu + mai (or Lat. non magis)", "examples": [{"ro": "numai unul", "en": "only one", "audio": "f2109107e828e14f"}], "audio": "4edab762b6345d9e"}, {"key": "prea", "prompt": "too (much)", "ro": "prea", "note": "excess", "ety": "Slavic prĕ (not lat. per)", "examples": [{"ro": "prea mult", "en": "too much", "audio": "9436e71284a83d61"}], "audio": "12a58774b30dd916"}]}
{"category": "indefinite-adverbs", "label": "Indefinite adverbs", "items": [{"key": "cândva", "prompt": "sometime, at some point", "ro": "cândva", "ety": "când + va", "examples": [{"ro": "cândva", "en": "sometime", "audio": "322c6ca120ebd8a2"}], "audio": "322c6ca120ebd8a2"}, {"key": "cumva", "prompt": "somehow; by any chance", "ro": "cumva", "ety": "cum + va", "examples": [{"ro": "cumva", "en": "somehow", "sense": "somehow", "audio": "2243a8f9634d4dfc"}, {"ro": "Ai cumva un pix?", "en": "Do you happen to have a pen?", "sense": "by any chance", "audio": "c722425f4b73767f"}], "audio": "2243a8f9634d4dfc"}, {"key": "nicăieri", "prompt": "nowhere", "ro": "nicăieri", "note": "with nu: nu… nicăieri", "ety": "Lat. nec aliubi ('not anywhere')", "examples": [{"ro": "Nu e nicăieri.", "en": "It's nowhere.", "audio": "cef7ea66ffd5e7a3"}], "audio": "05cae56084b8d6af"}, {"key": "oricând", "prompt": "anytime, whenever", "ro": "oricând", "ety": "ori + când", "examples": [{"ro": "oricând", "en": "anytime", "audio": "646c2192e0ac61d4"}], "audio": "646c2192e0ac61d4"}, {"key": "oricum", "prompt": "anyway, in any case", "ro": "oricum", "ety": "ori + cum", "examples": [{"ro": "Oricum plec.", "en": "I'm leaving anyway.", "audio": "7ddcc39b627d7455"}], "audio": "f68ee7289964d488"}, {"key": "oriunde", "prompt": "anywhere, wherever", "ro": "oriunde", "ety": "ori + unde", "examples": [{"ro": "oriunde vrei", "en": "wherever you want", "audio": "2be2159b7b96abf5"}], "audio": "191c0fda49badc5d"}, {"key": "undeva", "prompt": "somewhere", "ro": "undeva", "note": "the -va ending = 'some-'; ori- = 'any-'; nic- = 'no-'", "ety": "unde + va", "examples": [{"ro": "undeva aici", "en": "somewhere around here", "audio": "3eb4a420843bedd6"}], "audio": "4454886f672c0c83"}]}
{"category": "particles", "label": "Particles", "items": [{"key": "ba", "prompt": "no; on the contrary", "ro": "ba", "note": "ba da = yes! (contradicting a negative); ba chiar = even", "ety": "Slavic ba", "examples": [{"ro": "Ba da!", "en": "Yes it is! (contradicting)", "sense": "ba da", "audio": "94f6c6c97237014c"}, {"ro": "ba chiar", "en": "even, indeed", "sense": "ba chiar", "audio": "c6bb1c2c8f1ce643"}], "audio": "e19f4111c1f93a3c"}, {"key": "hai", "prompt": "come on; let's", "ro": "hai", "note": "also haide; urging or proposing", "ety": "interjection (also haide)", "examples": [{"ro": "Hai să mergem!", "en": "Come on, let's go!", "audio": "94a68f46183b22a0"}], "audio": "95ff54c93757b7ab"}, {"key": "iată", "prompt": "here is, behold, look", "ro": "iată", "note": "presentative — points something out", "ety": "from Bulgarian eto", "examples": [{"ro": "Iată!", "en": "Here it is! / Look!", "audio": "1669bda50133f9ac"}], "audio": "482cf1a38a2043a6"}, {"key": "măcar", "prompt": "at least; even", "ro": "măcar", "note": "nici măcar = not even", "ety": "from Greek makári", "examples": [{"ro": "măcar o dată", "en": "at least once", "audio": "a3c19992a8d8d073"}], "audio": "b80cc355e0fb97e1"}, {"key": "oare", "prompt": "(I wonder…) — question particle", "ro": "oare", "note": "marks a wondering/rhetorical question; often left untranslated", "ety": "Lat. volet ('it may'); cf. Alb. vallë", "examples": [{"ro": "Oare vine?", "en": "I wonder if he's coming?", "audio": "83f2b844eb56e375"}], "audio": "7dddb9310f4a0d20"}, {"key": "tocmai", "prompt": "just, exactly; precisely", "ro": "tocmai", "note": "emphasis on precision; tocmai de aceea = precisely because", "ety": "Slavic tŭkŭma", "examples": [{"ro": "Tocmai a plecat.", "en": "He just left.", "sense": "just now", "audio": "a638b46001cc2312"}, {"ro": "tocmai de aceea", "en": "precisely for that reason", "sense": "precisely", "audio": "b64d13fead41c1e0"}], "audio": "503212003083d143"}]}
{"category": "compound-prepositions", "label": "Compound prepositions", "items": [{"key": "de-către", "prompt": "by (agent of a passive)", "ro": "de către", "note": "marks the doer in passive sentences", "ety": "de + către", "examples": [{"ro": "văzut de către toți", "en": "seen by everyone", "audio": "a5d0fdab073bea58"}], "audio": "70855b9e243ad81f"}, {"key": "de-după", "prompt": "from behind", "ro": "de după", "ety": "de + după", "examples": [{"ro": "de după colț", "en": "from behind the corner", "audio": "4452b06009f62d3b"}], "audio": "66987523743ee311"}, {"key": "de-la", "prompt": "from (person/place/time)", "ro": "de la", "note": "starting point / source", "ety": "de + la", "examples": [{"ro": "de la mine", "en": "from me", "sense": "person", "audio": "7051ba1dd51afd7d"}, {"ro": "de la ora 5", "en": "from 5 o'clock", "sense": "time", "audio": "9d879b701f5e1f81"}], "audio": "7e736de01fe19ce3"}, {"key": "de-pe", "prompt": "off (of), from on", "ro": "de pe", "note": "source from a surface", "ety": "de + pe", "examples": [{"ro": "de pe masă", "en": "off the table", "audio": "fa665cf83a9b20df"}], "audio": "c36012c3bd931f5d"}, {"key": "de-sub", "prompt": "from under", "ro": "de sub", "ety": "de + sub", "examples": [{"ro": "de sub pat", "en": "from under the bed", "audio": "e30debaa3c74bec8"}], "audio": "5fc34fb609369a45"}, {"key": "dintre", "prompt": "from among, of (a group)", "ro": "dintre", "note": "unul dintre = one of", "ety": "din + între", "examples": [{"ro": "unul dintre ei", "en": "one of them", "audio": "037ab8f4e42edf41"}], "audio": "6dd5d5158779468a"}, {"key": "în-afară-de", "prompt": "except, apart from", "ro": "în afară de", "note": "marks an exception", "ety": "în + afară (< Lat. ad foras 'outside') + de", "examples": [{"ro": "toți în afară de mine", "en": "everyone except me", "audio": "176d962fa56577fd"}], "audio": "9f8764345b1863a6"}, {"key": "până-la", "prompt": "(up) to, until", "ro": "până la", "note": "endpoint in space or time", "ety": "până + la", "examples": [{"ro": "până la gară", "en": "up to the station", "sense": "place", "audio": "e092b1052128dfea"}, {"ro": "până la cinci", "en": "until five", "sense": "time", "audio": "77eb730d78a14851"}], "audio": "55b366251aecbe7d"}, {"key": "pe-la", "prompt": "around, approximately", "ro": "pe la", "note": "approximate place or time", "ety": "pe + la", "examples": [{"ro": "pe la ora 5", "en": "around 5 o'clock", "sense": "approx. time", "audio": "113db4193e68132a"}, {"ro": "pe la noi", "en": "around our place", "sense": "approx. place", "audio": "ed5d7e8c0d188f58"}], "audio": "d17897c195c675dc"}, {"key": "pe-lângă", "prompt": "besides, in addition to; past", "ro": "pe lângă", "note": "non-literal 'besides'; also 'alongside / past'", "ety": "pe + lângă", "examples": [{"ro": "pe lângă asta", "en": "besides that", "sense": "besides", "audio": "a2b37e247e0a307b"}, {"ro": "trece pe lângă casă", "en": "passes by the house", "sense": "past", "audio": "3c31d50690dfb7f4"}], "audio": "c5b853dca4462096"}, {"key": "printre", "prompt": "among, between", "ro": "printre", "ety": "prin + între", "examples": [{"ro": "printre noi", "en": "among us", "audio": "38985b34024f34c7"}], "audio": "2960160b7c3c1a12"}]}
{"category": "idioms", "label": "Idioms", "items": [{"key": "de-tot", "prompt": "utterly, completely", "ro": "de tot", "note": "literally 'of all'; an intensifier", "examples": [{"ro": "obosit de tot", "en": "utterly exhausted", "audio": "e1f8b975a159e718"}], "audio": "4bf139e3bd90e64c"}, {"key": "din-ce-în-ce", "prompt": "more and more, increasingly", "ro": "din ce în ce", "note": "literally 'from what in what'; + mai + adj", "examples": [{"ro": "din ce în ce mai bine", "en": "better and better", "audio": "62a98342efe74954"}], "audio": "a9c2278eb9d657f9"}, {"key": "mai-ales", "prompt": "especially", "ro": "mai ales", "note": "literally 'more chosen'", "examples": [{"ro": "mai ales iarna", "en": "especially in winter", "audio": "b3b2c987e4e43a32"}], "audio": "8b68030cbd814015"}, {"key": "nici-măcar", "prompt": "not even", "ro": "nici măcar", "note": "emphatic negative", "examples": [{"ro": "nici măcar unul", "en": "not even one", "audio": "6bcc6ad7aa8ce280"}], "audio": "09c2e870cad4a064"}, {"key": "nu-mai", "prompt": "no longer, not anymore", "ro": "nu mai", "note": "a split combo wrapping the verb: nu + mai + verb", "examples": [{"ro": "Nu mai vreau.", "en": "I don't want it anymore.", "audio": "bc16af46df492bb0"}], "audio": "0e9245080c0d6189"}]}
