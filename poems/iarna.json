{
  "title": "Iarna pe uliță",
  "author": "George Coșbuc",
  "audio_hash": "62448e9af3fc68d2",
  "duration_s": 186.24,
  "stanzas": [
    [
      {
        "line": "A-nceput de ieri să cadă",
        "start_s": 0.08,
        "line_audio": "2cfe16307c2dfe7e"
      },
      {
        "line": "Câte-un fulg, acum a stat,",
        "start_s": 1.64,
        "line_audio": "1a332c02d805d2a7"
      },
      {
        "line": "Norii s-au mai răzbunat",
        "start_s": 4.22,
        "line_audio": "a9ab391693c2bd63"
      },
      {
        "line": "Spre apus, dar stau grămadă",
        "start_s": 5.56,
        "line_audio": "f1173541e3824647"
      },
      {
        "line": "Peste sat.",
        "start_s": 7.5,
        "line_audio": "5e581a3e5293940e"
      }
    ],
    [
      {
        "line": "Nu e soare, dar e bine,",
        "start_s": 8.56,
        "line_audio": "dc6ca4b42f9ea33a"
      },
      {
        "line": "Și pe râu e numai fum.",
        "start_s": 10.56,
        "line_audio": "d3b1c8ea98e29d64"
      },
      {
        "line": "Vântu-i liniștit acum,",
        "start_s": 12.5,
        "line_audio": "9f84663dff1617ec"
      },
      {
        "line": "Dar năvalnic vuiet vine",
        "start_s": 14.18,
        "line_audio": "42af7b7ec8572f1f"
      },
      {
        "line": "De pe drum.",
        "start_s": 15.84,
        "line_audio": "1a34d02dcdcd2b1c"
      }
    ],
    [
      {
        "line": "Sunt copii. Cu multe sănii,",
        "start_s": 16.96,
        "line_audio": "14811c4d5d7ca9bf"
      },
      {
        "line": "De pe coastă vin țipând",
        "start_s": 18.92,
        "line_audio": "f6af5c4e2254d041"
      },
      {
        "line": "Și se-mping și sar râzând;",
        "start_s": 20.54,
        "line_audio": "011f4849c5509ad9"
      },
      {
        "line": "Prin zăpadă fac mătănii;",
        "start_s": 22.66,
        "line_audio": "4b35f431a0e49049"
      },
      {
        "line": "Vrând-nevrând.",
        "start_s": 24.44,
        "line_audio": "17438cfe207a514c"
      }
    ],
    [
      {
        "line": "Gură fac ca roata morii;",
        "start_s": 25.6,
        "line_audio": "dae250a74e35c4fb"
      },
      {
        "line": "Și de-a valma se pornesc,",
        "start_s": 27.42,
        "line_audio": "f0fd9f92ec9b17dc"
      },
      {
        "line": "Cum prin gard se gâlcevesc",
        "start_s": 29.08,
        "line_audio": "f3180f0c0c7296fe"
      },
      {
        "line": "Vrăbii gureșe, când norii",
        "start_s": 30.94,
        "line_audio": "6cb69c7f25e26c53"
      },
      {
        "line": "Ploi vestesc.",
        "start_s": 32.7,
        "line_audio": "869bb05411d606c8"
      }
    ],
    [
      {
        "line": "Cei mai mari acum, din sfadă,",
        "start_s": 33.98,
        "line_audio": "e26cc358b4bd8328"
      },
      {
        "line": "Stau pe-ncăierate puși;",
        "start_s": 36.1,
        "line_audio": "b4353f81a92f6caf"
      },
      {
        "line": "Cei mai mici, de foame-aduși,",
        "start_s": 37.82,
        "line_audio": "e22187621cd3b4e1"
      },
      {
        "line": "Se scâncesc și plâng grămadă",
        "start_s": 39.82,
        "line_audio": "a31843c7f4c02f45"
      },
      {
        "line": "Pe la uși.",
        "start_s": 41.76,
        "line_audio": "315b9456befff9d2"
      }
    ],
    [
      {
        "line": "Colo-n colț acum răsare",
        "start_s": 42.78,
        "line_audio": "c5ecb4b849c957fc"
      },
      {
        "line": "Un copil, al nu știu cui,",
        "start_s": 44.6,
        "line_audio": "ee63b500ee18e024"
      },
      {
        "line": "Largi de-un cot sunt pașii lui,",
        "start_s": 46.68,
        "line_audio": "993d15a7b73585be"
      },
      {
        "line": "Iar el mic, căci pe cărare",
        "start_s": 48.64,
        "line_audio": "0d13936c09abd977"
      },
      {
        "line": "Parcă nu-i.",
        "start_s": 50.6,
        "line_audio": "54a01cbe9cecce15"
      }
    ],
    [
      {
        "line": "Haina-i măturând pământul",
        "start_s": 51.58,
        "line_audio": "4aee44fbc358b708"
      },
      {
        "line": "Și-o târăște-abia, abia:",
        "start_s": 53.22,
        "line_audio": "7e846d361e56fde7"
      },
      {
        "line": "Cinci ca el încap în ea,",
        "start_s": 55.16,
        "line_audio": "f0baed9e5ca02af7"
      },
      {
        "line": "Să mai bată, soro, vântul",
        "start_s": 56.82,
        "line_audio": "e258500fbe30fa3d"
      },
      {
        "line": "Dac-o vrea!",
        "start_s": 58.38,
        "line_audio": "3d15192564099de6"
      }
    ],
    [
      {
        "line": "El e sol precum se vede,",
        "start_s": 59.4,
        "line_audio": "1566b30474a902b7"
      },
      {
        "line": "Mă-sa l-a trimis în sat,",
        "start_s": 61.24,
        "line_audio": "85bc110ce5999ecc"
      },
      {
        "line": "Vezi de-aceea-i încruntat,",
        "start_s": 62.84,
        "line_audio": "47c8a81ee4670445"
      },
      {
        "line": "Și s-avântă, și se crede",
        "start_s": 64.48,
        "line_audio": "1def11ff68cd26dc"
      },
      {
        "line": "Că-i bărbat;",
        "start_s": 66.14,
        "line_audio": "953bf8c09f879c28"
      }
    ],
    [
      {
        "line": "Cade-n brânci și se ridică",
        "start_s": 67.16,
        "line_audio": "b56b16c9f7ecef70"
      },
      {
        "line": "Dând pe ceafă puțintel",
        "start_s": 69.1,
        "line_audio": "51753322a76cce47"
      },
      {
        "line": "Toată lâna unui miel:",
        "start_s": 70.66,
        "line_audio": "2ba71201cf0da8dd"
      },
      {
        "line": "O căciulă mai voinică",
        "start_s": 72.22,
        "line_audio": "c68b88e6dcc95ba1"
      },
      {
        "line": "Decât el.",
        "start_s": 73.48,
        "line_audio": "cadc375931faf6b9"
      }
    ],
    [
      {
        "line": "Și tot vine, tot înoată,",
        "start_s": 74.44,
        "line_audio": "1e7d885d6d6246bc"
      },
      {
        "line": "Dar deodată cu ochi vii,",
        "start_s": 76.58,
        "line_audio": "411bd186771010da"
      },
      {
        "line": "Stă pe loc - să mi te ții!",
        "start_s": 78.28,
        "line_audio": "acc528a84e82960d"
      },
      {
        "line": "Colo, zgomotoasa gloată,",
        "start_s": 80.3,
        "line_audio": "785b72122eff4bcf"
      },
      {
        "line": "De copii!",
        "start_s": 82.28,
        "line_audio": "ec7839147ff48d70"
      }
    ],
    [
      {
        "line": "El degrabă-n jur chitește",
        "start_s": 83.26,
        "line_audio": "d6f4a4aa20612eed"
      },
      {
        "line": "Vrun ocol, căci e pierdut,",
        "start_s": 85.06,
        "line_audio": "bf19a03bb360616d"
      },
      {
        "line": "Dar copiii l-au văzut!",
        "start_s": 87.06,
        "line_audio": "9a19864b4e529cca"
      },
      {
        "line": "Toată ceata năvălește",
        "start_s": 88.7,
        "line_audio": "4e7f42577675c528"
      },
      {
        "line": "Pe-ntrecut.",
        "start_s": 90.14,
        "line_audio": "10efc72db3de8f9d"
      }
    ],
    [
      {
        "line": "- \"Uite-i, mă, căciula, frate,",
        "start_s": 91.22,
        "line_audio": "0cab4d2911d04cf8"
      },
      {
        "line": "Mare cât o zi de post -",
        "start_s": 93.08,
        "line_audio": "8d2a88827ce24833"
      },
      {
        "line": "Aoleu, ce urs mi-a fost!",
        "start_s": 94.86,
        "line_audio": "05ff5bac77ed61b7"
      },
      {
        "line": "Au sub dânsa șapte sate",
        "start_s": 97.04,
        "line_audio": "6c92d1d57e7fadd5"
      },
      {
        "line": "Adăpost!",
        "start_s": 98.72,
        "line_audio": "4d56a2884d3abbf2"
      }
    ],
    [
      {
        "line": "Unii-l iau grăbit la vale,",
        "start_s": 99.74,
        "line_audio": "0973855e8a75715d"
      },
      {
        "line": "Alții-n glumă parte-i țin -",
        "start_s": 101.46,
        "line_audio": "1a18e977a8a8017d"
      },
      {
        "line": "Uite-i, fără pic de vin",
        "start_s": 103.3,
        "line_audio": "6af8cf7dca5a853c"
      },
      {
        "line": "S-au jurat să-mbete-n cale",
        "start_s": 105.08,
        "line_audio": "f069c8f15694d8c3"
      },
      {
        "line": "Pe creștin!",
        "start_s": 106.66,
        "line_audio": "e3387b2161e8fd12"
      }
    ],
    [
      {
        "line": "Vine-o babă-ncet pe stradă",
        "start_s": 107.76,
        "line_audio": "fb4b6b7c85f439e3"
      },
      {
        "line": "În cojocul rupt al ei",
        "start_s": 109.5,
        "line_audio": "aea9f05c2af8a587"
      },
      {
        "line": "Și încins cu sfori de tei.",
        "start_s": 111.06,
        "line_audio": "9c79f5ff0a39d5ae"
      },
      {
        "line": "Stă pe loc acum să vadă",
        "start_s": 112.94,
        "line_audio": "0402a251de8b6124"
      },
      {
        "line": "Și ea ce-i.",
        "start_s": 114.58,
        "line_audio": "c1de1d1cc45d76cc"
      }
    ],
    [
      {
        "line": "S-oțărăște rău bătrâna",
        "start_s": 115.64,
        "line_audio": "1154e70d292505bb"
      },
      {
        "line": "Pentru micul Barba-cot.",
        "start_s": 117.18,
        "line_audio": "429fa9e35cd8b65f"
      },
      {
        "line": "- \"Ați înnebunit de tot -",
        "start_s": 118.9,
        "line_audio": "458a71001cb2b03e"
      },
      {
        "line": "Puiul mamii, dă-mi tu mâna",
        "start_s": 120.44,
        "line_audio": "965fa832c828ad46"
      },
      {
        "line": "Să te scot!",
        "start_s": 122.16,
        "line_audio": "b2c5f5e3a0fa8c50"
      }
    ],
    [
      {
        "line": "Cică vrei să stingi cu paie",
        "start_s": 123.08,
        "line_audio": "5710b5ad40962a31"
      },
      {
        "line": "Focul când e-n clăi cu fân,",
        "start_s": 124.82,
        "line_audio": "760dbed364f35d83"
      },
      {
        "line": "Și-apoi zici că ești român!",
        "start_s": 126.54,
        "line_audio": "36e6e7a7b9c5f82c"
      },
      {
        "line": "Biata bab-a-ntrat în laie",
        "start_s": 128.36,
        "line_audio": "e114f0b1f34e2f60"
      },
      {
        "line": "La stăpân.",
        "start_s": 130.0,
        "line_audio": "308c1d4d082a2e24"
      }
    ],
    [
      {
        "line": "Ca pe-o bufniț-o-nconjoară",
        "start_s": 130.94,
        "line_audio": "c105ed573470f5cd"
      },
      {
        "line": "Și-o petrec cu chiu cu vai,",
        "start_s": 132.56,
        "line_audio": "e224ed3293706328"
      },
      {
        "line": "Și se țin de dânsa scai,",
        "start_s": 134.38,
        "line_audio": "56c31408263886f8"
      },
      {
        "line": "Plină-i strâmta ulicioară",
        "start_s": 136.12,
        "line_audio": "0fa0bb2887337982"
      },
      {
        "line": "De alai.",
        "start_s": 137.56,
        "line_audio": "f49cd07dd536ea45"
      }
    ],
    [
      {
        "line": "Nu e chip să-i faci cu buna",
        "start_s": 138.42,
        "line_audio": "148e387345ed4820"
      },
      {
        "line": "Să-și păzească drumul lor!",
        "start_s": 139.9,
        "line_audio": "e90dbeb2f5dbb7e0"
      },
      {
        "line": "Râd și sar într-un picior,",
        "start_s": 141.68,
        "line_audio": "6d1b6148f52ef52f"
      },
      {
        "line": "Se-nvârtesc și țipă-ntruna",
        "start_s": 143.38,
        "line_audio": "7d1628656e2fa0b2"
      },
      {
        "line": "Mai cu zor.",
        "start_s": 145.04,
        "line_audio": "ba624a17ec5d6bb2"
      }
    ],
    [
      {
        "line": "Baba și-a uitat învățul:",
        "start_s": 146.08,
        "line_audio": "5b9a79f329284eaf"
      },
      {
        "line": "Bate,-njură, dă din mâini:",
        "start_s": 147.88,
        "line_audio": "ccb92446c2924c52"
      },
      {
        "line": "- \"Dracilor, sunteți păgâni?",
        "start_s": 149.92,
        "line_audio": "1fd1299a9bc130d9"
      },
      {
        "line": "Maica mea! Să stai cu bățul",
        "start_s": 151.88,
        "line_audio": "5d9823f7d6eb1569"
      },
      {
        "line": "Ca la câini!",
        "start_s": 153.84,
        "line_audio": "6d5591bf5d65027d"
      }
    ],
    [
      {
        "line": "Și cu bățul se-nvârtește",
        "start_s": 154.86,
        "line_audio": "5ef82dbd0a114a14"
      },
      {
        "line": "Ca să-și facă-n jur ocol;",
        "start_s": 156.42,
        "line_audio": "dfe6de89a16c2958"
      },
      {
        "line": "Dar abia e locul gol,",
        "start_s": 158.1,
        "line_audio": "0406293a037eff46"
      },
      {
        "line": "Și mulțimea năvălește",
        "start_s": 159.62,
        "line_audio": "c7b0b1dd49c448bc"
      },
      {
        "line": "Iarăși stol.",
        "start_s": 161.0,
        "line_audio": "6677ceece8a6a18e"
      }
    ],
    [
      {
        "line": "Astfel tabăra se duce",
        "start_s": 162.24,
        "line_audio": "769604140e747a37"
      },
      {
        "line": "Lălăind în chip avan:",
        "start_s": 163.74,
        "line_audio": "bc6769bceff9f1b5"
      },
      {
        "line": "Baba-n mijloc, căpitan,",
        "start_s": 165.36,
        "line_audio": "d1d6afc75f0de398"
      },
      {
        "line": "Scuipă-n sân și face cruce",
        "start_s": 167.16,
        "line_audio": "d50cd2f25c6186cc"
      },
      {
        "line": "De Satan.",
        "start_s": 168.9,
        "line_audio": "283734f627e8a19d"
      }
    ],
    [
      {
        "line": "Ba se răscolesc și câinii",
        "start_s": 169.82,
        "line_audio": "39a49a40e24c2011"
      },
      {
        "line": "De prin curți, și sar la ei.",
        "start_s": 171.32,
        "line_audio": "d784c062f6794ac5"
      },
      {
        "line": "Pe la garduri ies femei,",
        "start_s": 173.28,
        "line_audio": "c85cc2426756cb98"
      },
      {
        "line": "Se urnesc mirați bătrânii",
        "start_s": 175.26,
        "line_audio": "6d50cb0320fca87e"
      },
      {
        "line": "Din bordei.",
        "start_s": 177.02,
        "line_audio": "25300e9a2f59e3f7"
      }
    ],
    [
      {
        "line": "- \"Ce-i pe drum atâta gură?",
        "start_s": 178.08,
        "line_audio": "b94dcdfbfad8dfe6"
      },
      {
        "line": "- \"Nu-i nimic. Copii ștrengari.",
        "start_s": 179.86,
        "line_audio": "31e3e9d81cc88181"
      },
      {
        "line": "- \"Ei, auzi! Vedea-i-aș mari,",
        "start_s": 181.96,
        "line_audio": "50be07eb638ef544"
      },
      {
        "line": "Parcă trece-adunătură",
        "start_s": 184.14,
        "line_audio": "dec2cc1e68449514"
      },
      {
        "line": "De tătari!",
        "start_s": 185.42,
        "line_audio": "608fee4987114400"
      }
    ]
  ],
  "glosses": [
    {
      "ro": "uliță",
      "en": "(village) lane, narrow street",
      "note": "Slavic ulica 'street'"
    },
    {
      "ro": "fulg",
      "en": "snowflake"
    },
    {
      "ro": "norii s-au răzbunat",
      "en": "the clouds broke up / the sky cleared",
      "note": "lit. 'the clouds avenged themselves'"
    },
    {
      "ro": "grămadă",
      "en": "in a heap, crowded together"
    },
    {
      "ro": "năvalnic",
      "en": "rushing, impetuous"
    },
    {
      "ro": "vuiet",
      "en": "roar, din"
    },
    {
      "ro": "sănii",
      "en": "sleds (sg. sanie)",
      "note": "Bulgarian sani"
    },
    {
      "ro": "coastă",
      "en": "slope, hillside",
      "note": "Lat. costa 'rib'"
    },
    {
      "ro": "fac mătănii",
      "en": "tumble head over heels",
      "note": "lit. 'make prostrations' (church bows)"
    },
    {
      "ro": "se gâlcevesc",
      "en": "squabble, bicker"
    },
    {
      "ro": "vrăbii gureșe",
      "en": "chattering sparrows",
      "note": "vrabie < Slavic vrabiĭ"
    },
    {
      "ro": "se scâncesc",
      "en": "whimper, whine"
    },
    {
      "ro": "cărare",
      "en": "path, track",
      "note": "Lat. carraria 'cart-track'"
    },
    {
      "ro": "soro",
      "en": "'sister!' — familiar exclamation",
      "note": "vocative of soră"
    },
    {
      "ro": "sol",
      "en": "messenger, envoy"
    },
    {
      "ro": "mă-sa",
      "en": "his mother",
      "note": "colloquial for mama sa"
    },
    {
      "ro": "încruntat",
      "en": "frowning, scowling"
    },
    {
      "ro": "s-avântă",
      "en": "dashes, hurls himself forward",
      "note": "a se avânta"
    },
    {
      "ro": "cade-n brânci",
      "en": "falls headlong, on all fours"
    },
    {
      "ro": "ceafă",
      "en": "nape, back of the neck",
      "note": "cf. Albanian qafë (substrate)"
    },
    {
      "ro": "miel",
      "en": "lamb",
      "note": "Lat. agnellus (dim. of agnus)"
    },
    {
      "ro": "căciulă",
      "en": "tall fur cap"
    },
    {
      "ro": "înoată",
      "en": "(here) wades through the snow",
      "note": "lit. 'swims'"
    },
    {
      "ro": "gloată",
      "en": "crowd, mob, throng",
      "note": "Slavic glota"
    },
    {
      "ro": "chitește",
      "en": "(regional) sizes up, reckons",
      "note": "a chiti"
    },
    {
      "ro": "năvălește",
      "en": "surges, swarms",
      "note": "a năvăli"
    },
    {
      "ro": "pe-ntrecut",
      "en": "racing one another",
