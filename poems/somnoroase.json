{
  "title": "Somnoroase păsărele",
  "author": "Mihai Eminescu",
  "audio_hash": "bee29ed5e0983e6c",
  "duration_s": 26.32,
  "stanzas": [
    [
      {
        "line": "Somnoroase păsărele",
        "start_s": 0.1,
        "line_audio": "b6eeffa6c718a0a6"
      },
      {
        "line": "Pe la cuiburi se adună,",
        "start_s": 1.72,
        "line_audio": "77ddae6f95272d0d"
      },
      {
        "line": "Se ascund în rămurele -",
        "start_s": 3.46,
        "line_audio": "72576cebb47043d4"
      },
      {
        "line": "Noapte bună!",
        "start_s": 5.22,
        "line_audio": "0cc8518d192fa299"
      }
    ],
    [
      {
        "line": "Doar izvoarele suspină,",
        "start_s": 6.34,
        "line_audio": "6d5be218d1ff363a"
      },
      {
        "line": "Pe când codrul negru tace;",
        "start_s": 8.039,
        "line_audio": "916a6676293597e2"
      },
      {
        "line": "Dorm și florile-n grădină -",
        "start_s": 10.18,
        "line_audio": "77dcb1e52c3a466c"
      },
      {
        "line": "Dormi în pace!",
        "start_s": 12.22,
        "line_audio": "a0b3bab18cec1c21"
      }
    ],
    [
      {
        "line": "Trece lebăda pe ape",
        "start_s": 13.38,
        "line_audio": "c305bfbf23e9bff2"
      },
      {
        "line": "Între trestii să se culce -",
        "start_s": 15.02,
        "line_audio": "1e158eb4d06fd412"
      },
      {
        "line": "Fie-ți îngerii aproape,",
        "start_s": 16.92,
        "line_audio": "f7a92df44dd46fba"
      },
      {
        "line": "Somnul dulce!",
        "start_s": 18.78,
        "line_audio": "9161eaa3386dd10d"
      }
    ],
    [
      {
        "line": "Peste-a nopții feerie",
        "start_s": 20.02,
        "line_audio": "8ef5d1eca8440b05"
      },
      {
        "line": "Se ridică mândra lună,",
        "start_s": 21.64,
        "line_audio": "bec0e5c17da9a37c"
      },
      {
        "line": "Totu-i vis și armonie -",
        "start_s": 23.38,
        "line_audio": "7b5d5fcc594d5543"
      },
      {
        "line": "Noapte bună!",
        "start_s": 25.44,
        "line_audio": "0cc8518d192fa299"
      }
    ]
  ],
  "glosses": [
    {
      "ro": "somnoroase",
      "en": "sleepy, drowsy (f. pl.)",
      "note": "Lat. somnus 'sleep'; cf. somnolent"
    },
    {
      "ro": "păsărele",
      "en": "little birds",
      "note": "diminutive of pasăre; Lat. passer 'sparrow'"
    },
    {
      "ro": "cuiburi",
      "en": "nests",
      "note": "pl. of cuib"
    },
    {
      "ro": "se adună",
      "en": "gather, come together",
      "note": "Lat. adunare (ad + unus)"
    },
    {
      "ro": "rămurele",
      "en": "little branches",
      "note": "diminutive of ramură; Lat. ramus"
    },
    {
      "ro": "izvoarele",
      "en": "the springs, water-sources"
    },
    {
      "ro": "suspină",
      "en": "sigh",
      "note": "Lat. suspirare; cf. suspire"
    },
    {
      "ro": "codrul",
      "en": "the forest, woods"
    },
    {
      "ro": "tace",
      "en": "falls silent, is hushed",
      "note": "Lat. tacere 'be silent'; cf. tacit"
    },
    {
      "ro": "să se culce",
      "en": "to lie down (to sleep)",
      "note": "Lat. collocare 'to lay down'; cf. couch"
    },
    {
      "ro": "fie-ți",
      "en": "may they be to you",
      "note": "subjunctive of a fi 'to be' + dative -ți"
    },
    {
      "ro": "îngerii",
      "en": "the angels",
      "note": "Lat. angelus"
    },
    {
      "ro": "feerie",
      "en": "fairy enchantment, magic",
      "note": "from French féerie"
    },
    {
      "ro": "mândra",
      "en": "the proud / lovely one (here: the moon)"
    },
    {
      "ro": "armonie",
      "en": "harmony",
      "note": "Lat. harmonia (from Greek)"
    }
  ]
}